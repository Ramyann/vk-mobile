# Backend used by the existing Visit Kurdistan website. Point this to the
# production API before making a store build; the staging API is only a default
# for local previewing.
EXPO_PUBLIC_API_URL=https://dev-api.vkstgpermits.com/api

# Origin used only to identify the allowed Cloudflare Turnstile context inside
# the in-app verification sheet. Users are never sent to this website.
EXPO_PUBLIC_WEBSITE_URL=https://frontend.vkstgpermits.com

# Public Cloudflare Turnstile site key for the chat verification sheet.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
