{
  "expo": {
    "name": "Visit Kurdistan",
    "slug": "visit-kurdistan",
    "scheme": "visitkurdistan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visitkurdistan.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.visitkurdistan.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#36196D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Gilroy-Regular.ttf",
            "./assets/fonts/Gilroy-Medium.ttf",
            "./assets/fonts/Gilroy-SemiBold.ttf",
            "./assets/fonts/Gilroy-Bold.ttf"
          ]
        }
      ],
      "expo-file-system",
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#36196D"
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow $(PRODUCT_NAME) to show places near you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3f1dcb98-6bff-4ea6-b35d-17b2cd4d7acd"
      }
    },
    "owner": "ramyann"
  }
}
